# Database (Neon, Supabase, or Vercel Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/capper_tracker?schema=public"

# Google sign-in (NextAuth/Auth.js) - create an OAuth Client ID (Web
# application) at https://console.cloud.google.com/apis/credentials, with
# authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google (dev)
#   https://<your-domain>/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# Random secret NextAuth uses to sign session cookies/JWTs - generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="xxxxxxxx"

# Stripe (added in a later milestone)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=""
