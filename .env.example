# Database (Neon, Supabase, or Vercel Postgres connection string)
DATABASE_URL="postgresql://user:password@host:5432/capper_tracker?schema=public"

# Supabase Auth - from your Supabase project's Settings > API. Google and
# email/password providers are both configured in the Supabase dashboard
# (Authentication > Providers), not here - the Google Client ID/Secret and
# email settings live there, not in this app's env.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxx"

# Stripe - TEST MODE keys only (both start with sk_test_/whsec_test_..., not
# sk_live_/whsec_...). From your Stripe dashboard, with test mode toggled on:
# Developers > API keys for the secret key, Developers > Webhooks > (your
# endpoint) for the signing secret once you've registered
# <your-domain>/api/webhooks/stripe there. Server-only - never NEXT_PUBLIC,
# Checkout/Portal session creation happens entirely server-side, so none of
# this needs to reach the browser.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ids for each subscription tier's recurring Price object in Stripe
# (Product catalog > your product > Pricing), test mode. Only BASIC is
# actually purchasable right now (see PricingCards) - PRO_PRICE_ID can stay
# unset until Pro pricing is finalized; leaving it unset just means the Pro
# card shows "Coming soon" with no working checkout, which is already the
# intended behavior.
STRIPE_BASIC_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""

# "Build Your Own Model" feature flag - unset/anything but "true" keeps the
# sidebar tab and /model-builder route both fully inaccessible (route 404s).
MODEL_BUILDER_ENABLED=""
