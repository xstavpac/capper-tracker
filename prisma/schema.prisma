generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Theme {
  LIGHT
  DARK
}

enum Plan {
  FREE
  BASIC
  PRO
}

enum Source {
  TWITTER
  DISCORD
  TELEGRAM
  DUBCLUB
  INSTAGRAM
  FRIEND
  OTHER
}

enum BetType {
  SPREAD
  MONEYLINE
  TOTAL
  PLAYER_PROP
  NRFI // "No Run First Inning" - MLB-only, graded on combined 1st-inning runs
}

enum PickStatus {
  PENDING
  WIN
  LOSS
  PUSH
  CANCELLED
}

enum Period {
  FULL_GAME
  FIRST_HALF // "F5" in baseball terms, first half elsewhere
}

enum PickedSide {
  HOME
  AWAY
}

// ---------- Models ----------

model User {
  id                String   @id @default(cuid())
  supabaseId        String   @unique
  email             String   @unique
  name              String?
  profilePictureUrl String?
  themePreference   Theme    @default(DARK)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cappers                 Capper[]
  picks                   Pick[]
  parlayBets              ParlayBet[]
  subscription            Subscription?
  dismissedDuplicatePairs DismissedDuplicatePair[]

  @@map("users")
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan      @default(FREE)
  // Stripe's own subscription status string, stored verbatim (active,
  // trialing, past_due, canceled, unpaid, incomplete, incomplete_expired) -
  // not an enum, so a new Stripe status doesn't need a migration to store.
  // Whether a given status/plan combination actually grants paid-tier access
  // right now is computed by lib/entitlements.ts, never read off this field
  // directly - see isEntitledToPaidTier there for why (e.g. "canceled"
  // doesn't necessarily mean "downgrade immediately", "past_due" doesn't
  // mean "downgrade at all" while Stripe is still retrying).
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // The Stripe Price actually subscribed to - lets webhook handlers derive
  // `plan` (BASIC vs PRO) from the price id without hardcoding a lookup
  // table more than once.
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  // True while a cancellation is scheduled for period-end but hasn't taken
  // effect yet (Stripe keeps status "active" through this whole window) -
  // distinct from status ever becoming "canceled", which only happens once
  // the subscription has actually ended.
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("subscriptions")
}

// One row per processed Stripe webhook event id - checked (and inserted,
// atomically, via a unique-constraint-violation-as-dedupe-signal) before any
// event is actually handled, so redelivery of the same event (Stripe retries
// on anything but a 2xx response, and can also just send the same event more
// than once per their own docs) never re-applies its effects twice.
model StripeWebhookEvent {
  id          String   @id // Stripe's own event id (evt_...) - the dedupe key itself, not a synthetic one
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

model Sport {
  id      String   @id @default(cuid())
  name    String   @unique // NFL, NBA, MLB, NCAAF, NHL...
  leagues League[]
  picks   Pick[]
  legs    Leg[]

  @@map("sports")
}

model League {
  id      String @id @default(cuid())
  name    String
  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)
  picks   Pick[]
  legs    Leg[]

  @@unique([sportId, name])
  @@map("leagues")
}

model Capper {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  photoUrl            String?
  source              Source
  customSource        String?
  notes               String?
  isFavorite          Boolean  @default(false)
  sportSpecialization String?
  colorTag            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  picks Pick[]
  parlayBets ParlayBet[]
  dismissedPairsAsA DismissedDuplicatePair[] @relation("DismissedDuplicatePairCapperA")
  dismissedPairsAsB DismissedDuplicatePair[] @relation("DismissedDuplicatePairCapperB")

  @@index([userId])
  @@map("cappers")
}

// A capper pair the user has explicitly reviewed and confirmed are NOT the
// same person/channel (see cappers.ts's findSuspectedDuplicateCappers) -
// keeps that pair out of future duplicate scans permanently, tied to the
// underlying capper ids (not display names, which can change) so a rename
// doesn't resurface a pair someone already dismissed, and a genuinely
// different pair that happens to reuse an old name isn't accidentally
// suppressed. capperAId/capperBId are always stored with the
// lexicographically smaller id first (see dismissDuplicatePair) so "A~B" and
// "B~A" are the same row - order-independent by construction, not by a
// runtime OR query. Cascades on either capper being deleted (e.g. via
// mergeCappers) since a dismissal about an id that no longer exists is moot.
model DismissedDuplicatePair {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capperAId String
  capperA   Capper   @relation("DismissedDuplicatePairCapperA", fields: [capperAId], references: [id], onDelete: Cascade)
  capperBId String
  capperB   Capper   @relation("DismissedDuplicatePairCapperB", fields: [capperBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([capperAId, capperBId])
  @@index([userId])
  @@map("dismissed_duplicate_pairs")
}

model Pick {
  id         String     @id @default(cuid())
  userId     String // denormalized for fast per-user aggregation
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capperId   String
  capper     Capper     @relation(fields: [capperId], references: [id], onDelete: Cascade)
  sportId    String
  sport      Sport      @relation(fields: [sportId], references: [id])
  leagueId   String?
  league     League?    @relation(fields: [leagueId], references: [id])

  homeTeam   String
  awayTeam   String
  betType    BetType
  betDetail  String? // e.g. "Lakers -4.5" or free-text player prop
  odds       Int // American odds, e.g. -110, +150
  line       Float? // spread/total number, e.g. -4.5 or 8.5 - lets favorite/underdog be derived for Spread bets
  period     Period     @default(FULL_GAME)
  sportsbook String?
  units      Float
  datePosted DateTime   @default(now())
  gameTime   DateTime
  notes      String?
  status     PickStatus @default(PENDING)
  gradedAt   DateTime? // set once, on first transition out of PENDING - not touched again
  gradedViaFuzzyMatch Boolean? // true if auto-graded against a fuzzy (non-exact-team-name) GameResult match -
    // lets regradeFuzzyMatchedPicks find and re-check these later once a better/exact match may be available.
    // null for manually-graded picks and picks predating this field, which are never auto-re-checked.
  pickedSide PickedSide? // which side of homeTeam/awayTeam this pick is actually on, captured once at import
    // time from the specific matched game (see resolveGameAndOdds in bulk-picks.ts) - not re-derived from
    // betDetail text at grading time. Exists because gradePick's old bare-last-word-mascot text match breaks
    // down for a same-mascot NCAAF matchup (Clemson Tigers @ LSU Tigers - both reduce to "tigers"), where
    // detail.includes() can't tell the sides apart at all. null for picks predating this field and for any
    // import where the side genuinely couldn't be determined (including a same-mascot game where even the
    // matched nickname was ambiguous) - gradePick falls back to the old text-match path in that case, which
    // itself now refuses to guess when homeTeam and awayTeam share a mascot.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, capperId])
  @@index([userId, status])
  @@index([userId, sportId])
  @@index([userId, gameTime])
  @@index([userId, gradedAt])
  @@index([sportId, status]) // supports gradeAllPendingPicks' cross-user scan (WHERE sportId = ? AND status = 'PENDING'), which has no userId to lead with
  @@map("picks")
}

// A multi-leg bet (parlay/MLP) - one stake, one payout, resolved from N
// independent Leg rows below rather than being a Pick itself. Kept as its
// own table (not Pick + a nullable parentBetId) deliberately: every existing
// stats/report/leaderboard query already reads prisma.pick directly with no
// concept of "this row might be one leg of something bigger," and there are
// ~25 such call sites across stats.ts, picks.ts, cappers.ts, capper-
// panels.ts, sharp-money.ts and bulk-picks.ts. Reusing Pick would have meant
// retrofitting a parentBetId-is-null filter into every one of them, silently
// (not a crash - a wrong count) double/triple-counting units and W/L on any
// call site someone forgot. Keeping ParlayBet separate means those 25 sites
// need zero changes; only new, purpose-built parlay aggregation code has to
// know parlays exist at all.
//
// status/gradedAt are NOT written the same way Pick's are (once, when this
// row's own single game finishes) - a parlay's outcome depends on N games
// finishing independently, so it's a derived value, recomputed by
// recomputeParlayBetStatus (parlay-grading.ts) every time a leg leaves
// PENDING, and only actually persisted once that computation resolves to a
// final state. See that function for the short-circuit-on-LOSS and
// resolved-once-more-than-N-1-legs-decided rules, and for why the write
// itself is a conditional (status-must-still-be-PENDING) updateMany rather
// than an unconditional update - that's what stops a leg that finishes
// *after* the parlay has already locked in LOSS from ever touching this row
// again.
model ParlayBet {
  id         String     @id @default(cuid())
  userId     String // denormalized for fast per-user aggregation, same as Pick.userId
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capperId   String
  capper     Capper     @relation(fields: [capperId], references: [id], onDelete: Cascade)
  units      Float // total stake on the whole parlay, not per-leg
  datePosted DateTime   @default(now())
  notes      String?
  status     PickStatus @default(PENDING)
  gradedAt   DateTime? // set once, when recomputeParlayBetStatus first resolves this to a non-PENDING status - never touched again after that

  legs Leg[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, capperId])
  @@index([userId, status])
  @@map("parlay_bets")
}

// One leg of a ParlayBet - deliberately the same shape as Pick's own
// game-matching/grading fields (homeTeam/awayTeam/betType/line/period/
// gameTime), so grading.ts's existing pure functions (matchGameResult,
// resolveOutcome, gradePick, gradeTouchdownProp) grade a Leg exactly the way
// they grade a Pick today, unchanged - see parlay-grading.ts. odds is
// per-leg (this bet's own American odds), not the parlay's combined price;
// the parlay's effective payout is computed from surviving (non-PUSH) legs'
// odds at resolution time, not stored as a separate static field - a pushed
// leg changes the effective payout, so there is no single "the parlay's
// odds" that stays correct as a fixed input the way Pick.odds does.
model Leg {
  id          String    @id @default(cuid())
  parlayBetId String
  parlayBet   ParlayBet @relation(fields: [parlayBetId], references: [id], onDelete: Cascade)
  legIndex    Int // display/entry order within the parlay, 0-based

  sportId  String
  sport    Sport   @relation(fields: [sportId], references: [id])
  leagueId String?
  league   League? @relation(fields: [leagueId], references: [id])

  homeTeam  String
  awayTeam  String
  betType   BetType
  betDetail String?
  odds      Int
  line      Float?
  period    Period     @default(FULL_GAME)
  gameTime  DateTime
  status    PickStatus @default(PENDING)
  gradedAt  DateTime? // set once, on first transition out of PENDING - same rule as Pick.gradedAt
  gradedViaFuzzyMatch Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parlayBetId, legIndex])
  @@index([sportId, status]) // mirrors picks' same index - supports the parlay counterpart of gradeAllPendingPicks' cross-parlay scan
  @@map("legs")
}

model OddsSnapshot {
  id        String   @id @default(cuid())
  sportKey  String
  fetchDate String
  data      Json
  createdAt DateTime @default(now())

  @@unique([sportKey, fetchDate])
  @@map("odds_snapshots")
}

// A variable/metric's provenance - global (computed once, shared by every
// user, like every source in this app today) vs per-user (a hypothetical
// future user-supplied or user-scoped data source). Added now, before any
// PER_USER source exists, specifically so introducing one later is a matter
// of using the value, not a migration on tables that may by then hold real
// user data.
enum DataScope {
  GLOBAL
  PER_USER
}

// Precomputed, stored per-team betting tendencies (favorite/underdog win%,
// over/under rate) - built from a join of GameResult (actual outcomes)
// against the OddsSnapshot for that same day (pregame favorite/dog + total
// line), recomputed by recomputeTeamTendencies (see server/data/team-
// tendencies.ts), which the refresh-scores cron calls once daily right after
// persisting that day's final scores. Deliberately raw counts, not a stored
// percentage - MIN_TENDENCY_SAMPLE-gating and the actual win%/rate math live
// entirely in application code, so the threshold can be tuned without a
// migration. This row is overwritten in place every day (current cumulative
// totals only) - TeamTendencySnapshot below is the dated history of the same
// counts, and is what both backtesting and Charts actually read for any
// point-in-time value; this table remains the always-current source that
// gets snapshotted into it daily.
model TeamTendency {
  id             String    @id @default(cuid())
  sportKey       String
  teamName       String
  favWins        Int       @default(0)
  favLosses      Int       @default(0)
  favPushes      Int       @default(0)
  dogWins        Int       @default(0)
  dogLosses      Int       @default(0)
  dogPushes      Int       @default(0)
  overCount      Int       @default(0)
  underCount     Int       @default(0)
  totalPushCount Int       @default(0)
  // Which variable-registry provider computed this (see
  // server/data/providers/ - "internal_tendencies" today) and whether it's
  // shared globally or scoped to one user. A free-form string rather than an
  // enum, matching sourceId on the variable catalog (lib/model-builder.ts) -
  // new sources get added by registering a provider, not by editing this
  // schema.
  sourceId       String    @default("internal_tendencies")
  scope          DataScope @default(GLOBAL)
  updatedAt      DateTime  @updatedAt

  @@unique([sportKey, teamName])
  @@map("team_tendencies")
}

// The dated history TeamTendency itself doesn't keep - one row per team per
// calendar day, capturing that day's cumulative counts (same shape as
// TeamTendency) right after recomputeTeamTendencies runs. Written purely
// from data already computed that same cron pass - no additional external
// API requests. This is what makes tendency variables (Win% as favorite/
// underdog, over/under rate) actually chartable over time, and what
// tendencyProvider.resolveHistorical joins against for backtesting, instead
// of the previous "always use today's cumulative value" simplification -
// one calculation path for both consumers, per the no-parallel-path rule
// this schema follows for TeamStatSnapshot/PitcherStatSnapshot too.
model TeamTendencySnapshot {
  id             String    @id @default(cuid())
  sportKey       String
  teamName       String
  snapshotDate   String // "YYYY-MM-DD", Eastern - same convention as the other snapshot tables
  favWins        Int
  favLosses      Int
  favPushes      Int
  dogWins        Int
  dogLosses      Int
  dogPushes      Int
  overCount      Int
  underCount     Int
  totalPushCount Int
  sourceId       String    @default("internal_tendencies")
  scope          DataScope @default(GLOBAL)
  createdAt      DateTime  @default(now())

  @@unique([sportKey, teamName, snapshotDate])
  @@map("team_tendency_snapshots")
}

// One team's season-to-date stat line on one calendar day - captured daily
// by captureTeamStatSnapshots (server/data/stat-snapshots.ts), piggybacked
// on the existing refresh-scores cron. Building this dated history is what
// eventually lets team_stats condition backtesting move off the "unsupported"
// path in model-evaluation.ts: a historical game's date can be joined
// against the closest snapshot at-or-before it, the same way OddsSnapshot
// already gives odds/market conditions real point-in-time correctness.
model TeamStatSnapshot {
  id              String    @id @default(cuid())
  sportKey        String
  teamName        String
  snapshotDate    String // "YYYY-MM-DD", Eastern - same convention as OddsSnapshot.fetchDate
  wins            Int
  losses          Int
  winPct          Float
  runDifferential Int
  battingAvg      Float
  obp             Float
  slg             Float
  ops             Float
  era             Float
  whip            Float
  homeWins        Int
  homeLosses      Int
  awayWins        Int
  awayLosses      Int
  last10Wins      Int
  last10Losses    Int
  streakType      String? // "W" | "L" | null
  streakCount     Int
  sourceId        String    @default("mlb_stats_api")
  scope           DataScope @default(GLOBAL)
  createdAt       DateTime  @default(now())

  @@unique([sportKey, teamName, snapshotDate])
  @@map("team_stat_snapshots")
}

// One pitcher's season-to-date stat line on one calendar day - captured for
// that day's probable starters only (not every pitcher in the league), by
// capturePitcherStatSnapshots. Joined against GameStarters (below) at
// backtest time to resolve pitcher_stats conditions for a historical game.
model PitcherStatSnapshot {
  id             String    @id @default(cuid())
  sportKey       String
  pitcherId      Int // MLB Stats API's numeric person id
  pitcherName    String
  snapshotDate   String // "YYYY-MM-DD", Eastern
  era            Float
  whip           Float
  wins           Int
  losses         Int
  strikeouts     Int
  walks          Int
  inningsPitched Float
  homeEra        Float?
  roadEra        Float?
  daysRest       Int?
  sourceId       String    @default("mlb_stats_api")
  scope          DataScope @default(GLOBAL)
  createdAt      DateTime  @default(now())

  @@unique([sportKey, pitcherId, snapshotDate])
  @@map("pitcher_stat_snapshots")
}

model GameResult {
  id                 String   @id @default(cuid())
  sportKey           String
  externalId         String
  homeTeam           String
  awayTeam           String
  homeScore          Int
  awayScore          Int
  firstFiveHomeScore Int? // sum of innings 1-5 - null until 5 full innings have been played
  firstFiveAwayScore Int?
  firstInningHomeScore Int? // runs in inning 1 only - null until inning 1 is complete, for grading NRFI
  firstInningAwayScore Int?
  // MLB only - the game's full per-inning linescore, shape ScoreGameInning[]
  // from server/data/odds.ts ({num, home: {runs}|null, away: {runs}|null}),
  // captured at persistFinalScores time straight from the schedule API
  // response it already fetches (no extra call). Null for every other sport
  // and for rows persisted before this field existed - Game Pulse's
  // situational win-rate lookups only draw from rows where this is set, so
  // the usable sample starts accruing from whenever this shipped, not
  // retroactively.
  inningsJson        Json?
  gameDate           DateTime
  createdAt          DateTime @default(now())

  // ---- Team-trend ledger fields (Fav/Dog + Over/Under signal source) ----
  // Populated from the best odds data available around this game's date -
  // NOT a rigorously-captured true closing line. This app only caches odds
  // once per day (OddsSnapshot), at whatever time that day's fetch happened -
  // it may be hours before the actual closing line. Both fields stay null
  // when no odds data could be matched to this game at all (its date
  // predates any odds history, or that day's fetch was missed/out of season).
  // favWon/wentOver are deliberately NOT stored - both are fully derivable
  // from favTeam + homeScore/awayScore/totalLine already on this row, so
  // deriving them at read time avoids a stored value ever drifting out of
  // sync with the raw scores.
  favTeam    String? // whichever of homeTeam/awayTeam was the moneyline favorite per the matched snapshot
  totalLine  Float?  // the total (over/under) line from that same matched snapshot
  lineSource String? // "odds_snapshot" today (best-available daily cache) - reserved for a future "closing_capture" value if true near-gametime capture gets built later

  @@unique([sportKey, externalId])
  @@map("game_results")
}

// Persisted, growing history of model-engine predictions (Build Step 7) -
// one row per real game, populated incrementally by the cron
// (decay-delta-predictions.ts) rather than recomputed from scratch on every
// request the way Build Steps 5/6's own scripts do. modelId is its own
// field (not implied by a model-specific table) so a second model could
// reuse this same table later without a migration - scoped to computing
// only "decay-delta-v1" rows for now, per this step's own stated scope.
model DecayDeltaPrediction {
  id      String @id @default(cuid())
  modelId String @default("decay-delta-v1")

  // Null until the game grades - a pregame row's only identity is the
  // matchup itself (sportKey/homeTeam/awayTeam/gameDate). When the game
  // later grades, the existing pregame row is found by team pair + closest
  // gameDate (same repeat-matchup-safe matching odds.ts's matchScoreToGame
  // already uses elsewhere - GameResult.gameDate and OddsSnapshot's own
  // commenceTime come from two different upstream APIs and aren't
  // guaranteed byte-identical) and updated in place, not duplicated.
  gameResultId String?
  sportKey     String
  homeTeam     String
  awayTeam     String
  gameDate     DateTime

  favTeam   String
  dogTeam   String
  totalLine Float?

  // favRate/dogRate are the ALREADY-ROUNDED 0-100 percentages
  // (calc_fav_pct/calc_dog_pct), not the raw 0-1 weighted fractions - same
  // scale as delta (dv_decay_delta), matching decay-delta.ts's own
  // round-before-subtract convention. Storing the raw fraction here instead
  // would put favRate and delta on two different scales within the same row.
  favRate Float
  dogRate Float
  delta   Float
  bucket  String // bucket_decay_delta's matched ruleId, e.g. "rule_10_to_20"

  // Totals-side fields - Decay Delta has no over/under calculation of its
  // own, so these stay null for every row this step ever writes. Kept
  // nullable so a future totals-based model could populate them on this
  // same table without a migration, per this step's "keep the shape
  // generic" instruction - not populated or read by anything yet.
  overRate    Float?
  underRate   Float?
  totalDelta  Float?
  totalBucket String?

  // Both null until the game grades, then set exactly once and never
  // touched again - same immutability discipline as GameResult elsewhere in
  // this app (favWon/wentOver are derived at read time there; here they're
  // stored, since this row's whole purpose is being a permanent graded
  // record once written).
  favWon   Boolean?
  wentOver Boolean?

  computedAt DateTime  @default(now())
  gradedAt   DateTime?

  // gameResultId, not the (sportKey, homeTeam, awayTeam, gameDate) tuple, is
  // the real uniqueness key for a graded row - this app's seed data stores
  // gameDate as a noon-UTC placeholder for the calendar day (confirmed: 9
  // real same-day doubleheaders in the current baseball_mlb history share an
  // identical gameDate for two genuinely different GameResult rows), so that
  // tuple is NOT reliably unique. gameResultId is nullable (pregame rows),
  // and Postgres unique indexes treat every NULL as distinct from every
  // other NULL, so this only ever constrains graded rows against each other
  // - exactly the immutability guarantee this step needs ("never a second
  // graded row for the same game"). Pregame-row de-duplication is handled at
  // the application level instead (decay-delta-predictions.ts's own
  // exact-commenceTime check), not by a DB constraint.
  @@unique([modelId, gameResultId])
  @@map("decay_delta_predictions")
}
